# Supabase transaction pooler, port 6543 (runtime serverless di Vercel)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase session pooler, port 5432 (migrasi dan dev lokal)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Dev lokal boleh memakai DIRECT_URL sebagai DATABASE_URL agar lebih cepat.

# Minimal 32 byte acak, base64url
AUTH_SECRET="<random-secret>"

# Impor soal otomatis: Google Gemini (foto dan PDF)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Supabase Storage untuk unggah file 10 MB. Service role hanya di server.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Akun guru diisi dari prisma/seed-data.ts (GURU), password awal = NIP.
