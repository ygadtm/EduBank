# Supabase transaction pooler, port 6543 (runtime serverless di Vercel)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase session pooler, port 5432 (migrasi dan dev lokal)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Dev lokal boleh memakai DIRECT_URL sebagai DATABASE_URL agar lebih cepat.

# Minimal 32 byte acak, base64url
AUTH_SECRET="<random-secret>"

# Akun guru diisi dari prisma/seed-data.ts (GURU), password awal = NIP.
